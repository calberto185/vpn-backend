# ══════════════════════════════════════════════════════════
# BACKEND CENTRAL — Variables de entorno
# Copiar a .env y completar los valores
# ══════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production          # development | production

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DBNAME=vpn_central

# ── JWT (generar con: openssl rand -base64 32) ────────────
ACCESS_TOKEN_SECRET=<base64-32-bytes>
REFRESH_TOKEN_SECRET=<base64-32-bytes>
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ── Encriptación AES-256-GCM (openssl rand -base64 32) ───
SECRET_KEY=<base64-32-bytes>

# ── Admin inicial (se crea automáticamente al arrancar) ───
ROOT_USER=admin@tudominio.com
ROOT_PASS=contraseña-segura

# ── Bot de Telegram Python ────────────────────────────────
BOT_API_KEY=clave-secreta-compartida-con-el-bot
TELEGRAM_BOT_TOKEN=token-del-bot-de-telegram
ADMIN_TELEGRAM_ID=tu-telegram-id-numerico

# ── Google OAuth (para login/signup con Google) ───────────
GOOGLE_AUTH_CLIENT_ID=xxx.apps.googleusercontent.com

# ── WebSocket / Cluster ───────────────────────────────────
CLUSTER_AUTH_KEY=clave-para-websocket

# ── Email (nodemailer) ────────────────────────────────────
EMAIL_HOST=smtp.gmail.com        # o smtp.hostinger.com
EMAIL_PORT=465                   # 465 (SSL) | 587 (STARTTLS)
EMAIL_SECURE=true                # true para 465, false para 587
EMAIL_USER=tu@correo.com
EMAIL_PASS=app-password-gmail    # usar App Password, no la contraseña normal
NAME_APP=SVION VPN               # nombre que aparece en los emails

# ── SSH (para servidores OpenVPN) ─────────────────────────
SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# ── Storage (subida de archivos) ──────────────────────────
STORAGE_PATH=./storage

# ── reCAPTCHA (opcional) ──────────────────────────────────
RECAPTCHA_SECRET=


